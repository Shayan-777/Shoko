#!/usr/bin/env ruby
# frozen_string_literal: true

require 'fileutils'
require 'json'
require 'time'

module ShokoMigrationV2
  module_function

  def run
    ensure_config_root!

    if File.exist?(marker_path)
      puts 'Already migrated to v2.'
      return 0
    end

    backup_dir = create_backup
    normalize_config_json
    purge_cache
    write_marker(backup_dir)

    puts "Migration complete. Backup: #{backup_dir}"
    0
  rescue StandardError => e
    warn "Migration failed: #{e.class}: #{e.message}"
    1
  end

  def config_home
    ENV['XDG_CONFIG_HOME'].to_s.empty? ? File.join(Dir.home, '.config') : ENV['XDG_CONFIG_HOME']
  end

  def cache_home
    ENV['XDG_CACHE_HOME'].to_s.empty? ? File.join(Dir.home, '.cache') : ENV['XDG_CACHE_HOME']
  end

  def config_root
    File.join(config_home, 'shoko')
  end

  def cache_root
    File.join(cache_home, 'shoko')
  end

  def marker_path
    File.join(config_root, '.migrated_v2')
  end

  def backup_root
    File.join(config_home, 'shoko-backups')
  end

  def ensure_config_root!
    FileUtils.mkdir_p(config_root)
  end

  def create_backup
    FileUtils.mkdir_p(backup_root)
    stamp = Time.now.utc.strftime('%Y%m%d%H%M%S')
    backup_dir = File.join(backup_root, "v2-#{stamp}-#{Process.pid}")
    FileUtils.mkdir_p(backup_dir)
    FileUtils.cp_r(File.join(config_root, '.'), backup_dir)
    backup_dir
  end

  def normalize_config_json
    config_path = File.join(config_root, 'config.json')
    return unless File.exist?(config_path)

    parsed = JSON.parse(File.read(config_path))
    File.write(config_path, JSON.generate(parsed))
  rescue JSON::ParserError
    # Keep original file as-is when JSON is invalid.
  end

  def purge_cache
    FileUtils.rm_rf(cache_root)
  end

  def write_marker(backup_dir)
    payload = {
      migrated_at: Time.now.utc.iso8601,
      backup: backup_dir
    }
    File.write(marker_path, JSON.pretty_generate(payload))
  end
end

exit ShokoMigrationV2.run
