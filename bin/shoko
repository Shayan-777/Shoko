#!/usr/bin/env ruby
# frozen_string_literal: true

app_root = File.expand_path('..', __dir__)
lib_dir = File.join(app_root, 'lib')
$LOAD_PATH.unshift(lib_dir) unless $LOAD_PATH.include?(lib_dir)

begin
  # Only activate Bundler when explicitly running under it (e.g. bundle exec).
  if ENV['BUNDLE_GEMFILE'] || ENV['BUNDLE_BIN_PATH']
    require 'bundler/setup'
  end
rescue LoadError
  # Running without Bundler (e.g., installed gem).
end

require 'shoko'
require 'shoko/bootstrap/migration_preflight'

Shoko::CLI.run(
  ARGV,
  preflight_checker: -> { Shoko::Bootstrap::MigrationPreflight.ensure_migrated! },
  app_factory: ->(epub_path:, log_config:) do
    Shoko::Bootstrap::ContainerFactory.build_unified_application(epub_path: epub_path, log_config: log_config)
  end,
  migration_error_class: Shoko::Bootstrap::MigrationPreflight::MigrationRequiredError
)
